<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="winui_local_movie.PendingVideosPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:winui_local_movie">

  <Grid Padding="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="待观看" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="DescriptionText" Text="尚未观看的视频" Foreground="Gray"/>
    </StackPanel>
    <GridView x:Name="VideosGridView" Grid.Row="1" Margin="0,16,0,0"
              IsItemClickEnabled="True" ItemClick="VideosGridView_ItemClick">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsWrapGrid Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </GridView.ItemsPanel>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="local:VideoModel">
          <StackPanel Width="220" Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            <Border Height="125" Background="LightGray">
              <Image Source="{x:Bind GetThumbnailPath(FilePath)}" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1"
                       TextTrimming="CharacterEllipsis" Margin="8,8,8,0"/>
            <TextBlock Text="{x:Bind FormatDuration(Duration)}" Foreground="Gray"
                       Margin="8,2,8,8"/>
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
